<mxfile host="app.diagrams.net" modified="2026-08-28T00:00:00.000Z" agent="SERVIR GRP architecture generator" version="24.7.17" type="device" compressed="false"><diagram id="c1-system-context" name="C1 System Context"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="C1 — SERVIR GRP Demo: System Context" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontColor=#08427B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="38" as="geometry" /></mxCell><mxCell id="subtitle" value="Purpose: show who uses the controlled demo and which external services make the live AI observability flow work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5F6B70;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="28" as="geometry" /></mxCell><mxCell id="planner" value="&lt;b&gt;Planner / disaster preparedness staff&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Web browser · EN/TH&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Runs the Phaya Thai RP100 assessment, asks for an AI explanation and gives helpful/not-helpful feedback." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#08427B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="190" width="310" height="180" as="geometry" /></mxCell><mxCell id="reviewer" value="&lt;b&gt;Product, technical and leadership reviewer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Web browser&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Reviews answer evidence, traces, evaluator results, version comparison, cost and governance status." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#08427B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="45" y="500" width="310" height="180" as="geometry" /></mxCell><mxCell id="system" value="&lt;b&gt;SERVIR Global Risk Platform Demo&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Software System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Caddy + JavaScript + Node.js · Type B-lite&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Supports evacuation-preparedness planning and one observable AI explanation for Phaya Thai, RP100 and a 1 km shelter-proximity threshold." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#08427B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="500" y="245" width="520" height="275" as="geometry" /></mxCell><mxCell id="osm" value="&lt;b&gt;OpenStreetMap&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Public tile service&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Provides the real low-traffic basemap tiles used by the planning interface." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F5F6;strokeColor=#5F6B70;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1210" y="115" width="310" height="145" as="geometry" /></mxCell><mxCell id="openai" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;gpt-5.2 · Responses API&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Generates one planning explanation and runs three narrow AI judges." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F4ED;strokeColor=#2E7D5B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1210" y="335" width="310" height="150" as="geometry" /></mxCell><mxCell id="langfuse" value="&lt;b&gt;Langfuse Cloud&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Configured non-production project&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Stores traces, observations, evaluator scores, token/cost metadata and planner feedback." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F1EAF5;strokeColor=#704090;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1210" y="565" width="310" height="165" as="geometry" /></mxCell><mxCell id="e1" value="Uses planning journey; asks Explain with AI; submits feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2380B0;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="planner" target="system"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Reviews five AI assurance views" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2380B0;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="reviewer" target="system"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Requests basemap tiles over HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5F6B70;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system" target="osm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Sends governed pilot context; receives answer and judge verdicts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D5B;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system" target="openai"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Writes live trace, observations, scores and feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#704090;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="system" target="langfuse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Opens exact trace for investigation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#704090;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="reviewer" target="langfuse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c1note" value="REAL SERVICES: OpenStreetMap · OpenAI · Langfuse     |     ILLUSTRATIVE: GRP evidence, geometry, population and analytical values     |     HUMAN REVIEW REQUIRED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#C77724;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1520" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c2-containers" name="C2 Containers"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="C2 — SERVIR GRP Demo: Container Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontColor=#08427B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1520" height="38" as="geometry" /></mxCell><mxCell id="subtitle" value="Purpose: show what runs locally or in Docker Compose, what each container does, and how a human action becomes a Langfuse trace." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#5F6B70;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1520" height="28" as="geometry" /></mxCell><mxCell id="planner2" value="&lt;b&gt;Planner / reviewer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Browser&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Uses the planning interface, assurance views and feedback controls." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#08427B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="250" height="165" as="geometry" /></mxCell><mxCell id="reviewer2" value="&lt;b&gt;Technical reviewer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Browser&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Follows the exact trace in Langfuse for diagnosis and review." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#08427B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="250" height="140" as="geometry" /></mxCell><mxCell id="boundary" value="SERVIR GRP Demo software system · Local runner or Docker Compose / AWS Lightsail target" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;fillOpacity=35;strokeColor=#2380B0;strokeWidth=2;dashed=1;dashPattern=8 5;fontColor=#08427B;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="320" y="105" width="900" height="655" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;Web application and reverse proxy&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Container]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Caddy 2.8 + HTML/CSS/JavaScript&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Serves the EN/TH planning UI, Leaflet map and five assurance views. Proxies same-origin /api/* calls to the backend." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E8F4FA;strokeColor=#2380B0;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="385" y="205" width="350" height="205" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;Observable AI pilot API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Container]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Node.js 22 · built-in HTTP/fetch&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Validates the fixed pilot contract; reads governed evidence; calls OpenAI; runs four code checks and three judges; sends traces/scores and feedback to Langfuse. No LangGraph is used." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F4ED;strokeColor=#2E7D5B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="825" y="180" width="335" height="300" as="geometry" /></mxCell><mxCell id="evidence" value="&lt;b&gt;Versioned illustrative evidence&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Embedded Data Store]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Embedded in backend image · demo-evidence-v1.0&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Three stable evidence records plus deterministic values: 18,640 exposed and 11,240 beyond 1 km." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF2DE;strokeColor=#C77724;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="540" width="330" height="145" as="geometry" /></mxCell><mxCell id="secrets" value="&lt;b&gt;Server-side configuration&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[Configuration]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Never sent to browser or Git&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;OpenAI and Langfuse credentials stay in ignored .env or an approved deployment secret store." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F5F6;strokeColor=#5F6B70;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="825" y="560" width="335" height="125" as="geometry" /></mxCell><mxCell id="osm2" value="&lt;b&gt;OpenStreetMap tiles&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;HTTPS&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Real basemap for limited prototype traffic." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F5F6;strokeColor=#5F6B70;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1300" y="125" width="260" height="120" as="geometry" /></mxCell><mxCell id="openai2" value="&lt;b&gt;OpenAI Responses API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;gpt-5.2&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;One answer generation plus three narrow judge calls." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E7F4ED;strokeColor=#2E7D5B;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1300" y="350" width="260" height="130" as="geometry" /></mxCell><mxCell id="langfuse2" value="&lt;b&gt;Langfuse Cloud&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#2380B0&quot;&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5F6B70&quot;&gt;&lt;i&gt;Cloud dashboard + ingestion API&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Root trace, 8 observations, evaluator scores and human feedback." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F1EAF5;strokeColor=#704090;strokeWidth=2;fontColor=#263238;fontSize=12;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="1300" y="600" width="260" height="145" as="geometry" /></mxCell><mxCell id="c2e1" value="HTTPS: assessment, Explain with AI, assurance views and feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2380B0;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="planner2" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e2" value="Same-origin /api/observability/* JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D5B;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frontend" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e3" value="Browser requests map tiles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5F6B70;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frontend" target="osm2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e4" value="Reads fixed evidence IDs, versions and deterministic values" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C77724;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="evidence"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e5" value="Injects provider configuration at runtime" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5F6B70;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="secrets" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e6" value="Answer + 3 judge requests; receives text, verdicts and usage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D5B;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="openai2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e7" value="Ingests trace, spans, generations, scores and feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#704090;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="langfuse2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2e8" value="Opens trace dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#704090;fontColor=#263238;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="reviewer2" target="langfuse2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2note" value="CONTROLLED PILOT BOUNDARY: fixed Phaya Thai · RP100 · 1 km contract; 5 requests/client/10 min; no production authentication or durable quota yet." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#C77724;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="795" width="1240" height="38" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>