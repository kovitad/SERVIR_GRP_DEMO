# Use :80 for HTTP-only access by Lightsail public IP.
SITE_ADDRESS=:80

# For automatic HTTPS after DNS points to the Lightsail static IP, use:
# SITE_ADDRESS=prototype.example.org

IMAGE_TAG=local

# Role-based prototype access. Use long, unique passwords and keep the populated
# .env file outside Git. Plain-text environment passwords are prototype-only;
# use an identity provider or approved password-hash store before broader use.
ADMIN_USERNAME=
ADMIN_PASSWORD=
PLANNER_USERNAME=
PLANNER_PASSWORD=

# Show one-click Planner access on the sign-in page. This never enables Admin
# access and does not expose the configured Planner password to the browser.
DEMO_QUICK_LOGIN=true

# Type B-lite observable AI pilot. Keep mock until cloud-data approval and
# server-side credentials are configured; never commit populated secrets.
AI_OBSERVABILITY_MODE=mock

# Master cost/safety lock. Keep false by default. To permit an Admin to open a
# short runtime window, set true and restart the backend. Runtime starts OFF.
AI_FEATURE_ALLOWED=false
AI_RUNTIME_WINDOW_MINUTES=15
AI_RUNTIME_REQUEST_BUDGET=5

# Refuse AI generation over public HTTP. Set false only for an explicitly
# accepted HTTP demo; names, feedback and session traffic will not be encrypted.
AI_REQUIRE_HTTPS=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
